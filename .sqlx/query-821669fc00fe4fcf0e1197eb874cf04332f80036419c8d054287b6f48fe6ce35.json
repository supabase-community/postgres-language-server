  "query": "SELECT\n  e.name as \"name!\",\n  n.nspname AS schema,\n  e.default_version as \"default_version!\",\n  x.extversion AS installed_version,\n  e.comment\nFROM\n  pg_available_extensions() e\n  LEFT JOIN pg_extension x ON e.name = x.extname\n  LEFT JOIN pg_namespace n ON x.extnamespace = n.oid\n",
