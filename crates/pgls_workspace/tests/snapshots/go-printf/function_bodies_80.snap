---
source: crates/pgls_workspace/tests/template_formatting.rs
---
-- a body with a directive is kept as written, so that the string with it stays the same
create function f(n int)
returns int
language sql
as $$ select n + %d $$;
-- a body without one is formatted
create function g()
returns int
language sql
as $$
select 1;
$$;
-- a quoted body with a directive is formatted around, and stays as written
create function h()
returns text
language sql
as 'select ''%s''';
