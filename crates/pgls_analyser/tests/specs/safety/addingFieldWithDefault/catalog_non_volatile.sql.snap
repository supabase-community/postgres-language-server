# Input
```
-- Since Postgres 11, a default without volatile functions is stored in the catalog instead of
-- rewriting the table. Built-in operators and casts are never volatile.
-- catalog: builtin
-- expect_no_diagnostics
ALTER TABLE users ADD COLUMN status text DEFAULT 'active';
ALTER TABLE users ADD COLUMN created_on date DEFAULT now()::date;
ALTER TABLE users ADD COLUMN expires_at timestamptz DEFAULT now() + interval '30 days';
ALTER TABLE users ADD COLUMN score int DEFAULT 1 + 1;
ALTER TABLE users ADD COLUMN code text DEFAULT lower('ABC') || '-' || 1::text;
ALTER TABLE users ADD COLUMN tags text[] DEFAULT ARRAY[]::text[];
ALTER TABLE users ADD COLUMN kind text DEFAULT CASE WHEN 1 BETWEEN 0 AND 2 THEN 'a' ELSE 'b' END;
ALTER TABLE users ADD COLUMN settings jsonb DEFAULT coalesce(NULL, '{}'::jsonb);

```
