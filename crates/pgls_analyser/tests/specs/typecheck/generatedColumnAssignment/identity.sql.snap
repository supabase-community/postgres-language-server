# Input
```
create table users (
  id int generated always as identity primary key,
  legacy_id int generated by default as identity,
  name text
);
insert into users (name) values ('a');
insert into users (id, name) values (default, 'b');
insert into users (id, name) values (default, 'c'), (default, 'd');
insert into users (id, name) overriding system value values (100, 'e');
insert into users (id, name) overriding user value values (100, 'f');
insert into users (legacy_id, name) values (5, 'g');
update users set legacy_id = 6, id = default;
-- expect_lint/generatedColumnAssignment
insert into users (id, name) values (101, 'h');
-- expect_lint/generatedColumnAssignment
insert into users values (102, 7, 'i');
-- expect_lint/generatedColumnAssignment
insert into users (id, name) values (default, 'j'), (103, 'k');
-- expect_lint/generatedColumnAssignment
insert into users (id, name) select 104, 'l';
-- expect_lint/generatedColumnAssignment
update users set id = 105;
-- `OVERRIDING` doesn't apply to `ON CONFLICT DO UPDATE`
-- expect_lint/generatedColumnAssignment
insert into users (id, name) overriding system value values (100, 'm') on conflict (id) do update set id = 106;

```

