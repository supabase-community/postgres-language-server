# Input
```
create table parent (id int generated always as identity, name text);
-- Inheritance children don't inherit identity
create table child (extra int) inherits (parent);
insert into child (id, name) values (1, 'a');
-- `LIKE` copies identity only with `INCLUDING IDENTITY`
create table copied (like parent);
insert into copied (id, name) values (1, 'a');
create table copied_identity (like parent including identity);
-- expect_lint/generatedColumnAssignment
insert into copied_identity (id, name) values (1, 'a');
create table accounts (id int not null, name text);
alter table accounts alter column id add generated always as identity;
-- expect_lint/generatedColumnAssignment
insert into accounts (id, name) values (1, 'a');
alter table accounts alter column id set generated by default;
insert into accounts (id, name) values (2, 'b');
alter table accounts alter column id set generated always;
-- expect_lint/generatedColumnAssignment
update accounts set id = 3;
alter table accounts alter column id drop identity;
update accounts set id = 4;
alter table accounts add column number int generated always as identity;
-- expect_lint/generatedColumnAssignment
insert into accounts (name, number) values ('c', 5);
-- Partitions inherit identity since Postgres 17. The specs run with the catalog of the test
-- database, Postgres 15, where they don't.
create table events (id int generated always as identity, at date) partition by range (at);
create table events_2025 partition of events for values from ('2025-01-01') to ('2026-01-01');
insert into events_2025 (id, at) values (1, '2025-06-01');

```

