select
  my_pair_func(
    'amountTTC', to_amount(amount_ttc, invoices.currency),
    'amountVAT', to_amount(amount_vat, invoices.currency),
    'rateVAT', round(amount_ttc / amount_ht * 100)
  )
  as grouped,
  jsonb_build_object(
    'id',
    users.id,
    'email',
    users.email,
    'profile',
    users.name
  )
  as ungrouped
from
  users;
