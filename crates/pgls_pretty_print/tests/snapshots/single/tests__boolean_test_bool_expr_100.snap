---
source: crates/pgls_pretty_print/tests/tests.rs
input_file: crates/pgls_pretty_print/tests/data/single/boolean_test_bool_expr.sql
---
select
  id
from
  s.units
where
  (units.has_history or
  units.has_shares or
  units.has_calls)
  is true and
  (units.is_active and units.is_visible)
  is not false;
