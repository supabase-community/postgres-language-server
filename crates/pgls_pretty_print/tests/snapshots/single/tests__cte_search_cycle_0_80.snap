---
source: crates/pgls_pretty_print/tests/tests.rs
input_file: crates/pgls_pretty_print/tests/data/single/cte_search_cycle_0.sql
---
with recursive search_graph (f, t, label) as (
  select * from graph as g
  union all
  select g.* from graph as g, search_graph as sg where g.f = sg.t
)
search breadth first by f, t set seq
cycle f, t set is_cycle to 'Y' default 'N' using path
select
  *
from
  search_graph
order by seq;
