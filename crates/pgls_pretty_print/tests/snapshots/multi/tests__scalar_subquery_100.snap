---
source: crates/pgls_pretty_print/tests/tests.rs
input_file: crates/pgls_pretty_print/tests/data/multi/scalar_subquery.sql
---
create policy members_only
on documents
as permissive
for all
to public
using (organization_id = (select organization_id from memberships where user_id = auth.uid()));

select
  *
from
  documents as d
where
  d.owner_id = (
    select m.user_id from memberships as m where m.organization_id = d.organization_id limit 1
  );

select
  *
from
  documents
where
  tags = array(
    select tag from document_tags where document_tags.document_id = documents.id order by tag
  );

select
  *
from
  t
where
  a = (
    select coalesce((select max(x) from y where y.id = t.id and y.kind = 'some kind of value'), 0)
  );

select * from t where a = (select 1);
