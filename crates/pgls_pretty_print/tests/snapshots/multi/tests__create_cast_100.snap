---
source: crates/pgls_pretty_print/tests/tests.rs
input_file: crates/pgls_pretty_print/tests/data/multi/create_cast.sql
---
create type casttesttype;

create function casttesttype_in(cstring)
returns casttesttype
language internal
immutable
strict
as $$textin$$;

create function casttesttype_out(casttesttype)
returns cstring
language internal
immutable
strict
as $$textout$$;

create type casttesttype (
  internallength = variable,
  input = casttesttype_in,
  output = casttesttype_out,
  alignment = int4
);

create function casttestfunc(casttesttype)
returns int4
language sql
as $$ SELECT 1; $$;

select casttestfunc(cast('foo' as text));

create cast (text as casttesttype) without function;

select casttestfunc(cast('foo' as text));

select casttestfunc(cast(cast('foo' as text) as casttesttype));

drop cast (text as casttesttype);

create cast (text as casttesttype) without function as implicit;

select casttestfunc(cast('foo' as text));

select cast(cast(1234 as int4) as casttesttype);

create cast (int4 as casttesttype) with inout;

select cast(cast(1234 as int4) as casttesttype);

drop cast (int4 as casttesttype);

create function int4_casttesttype(int4)
returns casttesttype
language sql
as $$ SELECT ('foo'::text || $1::text)::casttesttype; $$;

create cast (int4 as casttesttype) with function int4_casttesttype(int4) as implicit;

select cast(cast(1234 as int4) as casttesttype);

drop function int4_casttesttype(int4) cascade;

create function bar_int4_text(int4)
returns text
language sql
as $$ SELECT ('bar'::text || $1::text); $$;

create cast (int4 as casttesttype) with function bar_int4_text(int4) as implicit;

select cast(cast(1234 as int4) as casttesttype);

select
  pg_describe_object(classid, objid, objsubid) as obj,
  pg_describe_object(refclassid, refobjid, refobjsubid) as objref,
  deptype
from
  pg_depend
where
  classid = cast('pg_cast' as regclass) and
  objid =
  (
    select
      oid
    from
      pg_cast
    where
      castsource = cast('int4' as regtype) and casttarget = cast('casttesttype' as regtype)
  )
order by refclassid;
