select
  x,
  cast(x as int8) as int8_value
from
  (
    values
      (-cast(2.5 as float8)),
      (-cast(1.5 as float8)),
      (-cast(0.5 as float8)),
      (cast(0.0 as float8)),
      (cast(0.5 as float8)),
      (cast(1.5 as float8)),
      (cast(2.5 as float8))
  )
  as t (x);

select
  x,
  cast(x as int8) as int8_value
from
  (
    values
      (-cast(2.5 as numeric)),
      (-cast(1.5 as numeric)),
      (-cast(0.5 as numeric)),
      (cast(0.0 as numeric)),
      (cast(0.5 as numeric)),
      (cast(1.5 as numeric)),
      (cast(2.5 as numeric))
  )
  as t (x);

