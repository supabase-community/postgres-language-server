  x,
  last_value(x) over (order by x range between current row and 4 following)
from
  generate_series(2147483644, 2147483646) as x;

select
  x,
  last_value(x) over (order by x desc range between current row and 5 following)
from
  generate_series(-2147483646, -2147483644) as x;

select
  x,
  last_value(x) over (order by x range between current row and 4 following)
from
  generate_series(9223372036854775804, 9223372036854775806) as x;

select
  x,
  last_value(x) over (order by x desc range between current row and 5 following)
from
  generate_series(-9223372036854775806, -9223372036854775804) as x;

