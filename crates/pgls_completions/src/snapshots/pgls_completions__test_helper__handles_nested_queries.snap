***Setup***

create schema private;

create table public.users (
    id serial primary key,
    name text
);

create table public.audio_books (
    id serial primary key,
    narrator text
);

create table private.audio_books (
    id serial primary key,
    narrator_id text
);


--------------

select * from (
    | from private.audio_books
) as subquery
join public.users u
on u.id = subquery.id;

Results:
select - select (Keyword)

--------------

select * from (
    s| from private.audio_books
) as subquery
join public.users u
on u.id = subquery.id;

Results:
select - select (Keyword)

--------------

select * from (
    select | from private.audio_books
) as subquery
join public.users u
on u.id = subquery.id;

