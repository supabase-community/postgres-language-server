  1 | -- format specs of Rust
  2 | select {:>8}, {0:+#010.3e}, {name:.*}, {:x?}, {:<1$} from t;
    | select $a___, $a__________, $b_______, $c___, $d____ from t;
  3 | -- found by the fuzzer: `$$` is no format spec, so `{:$$}` starts no directive. Read as one, it ran
  4 | -- over the `$$` that ends the string
  5 | sElect($${:$$})select('');$$)

